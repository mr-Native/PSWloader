+/* 0.7.216.1230: a commit from Settings picked another real mode - the same sequence as a pick (mode change, then the replug,
+ * so dxgkrnl re-reads the running tuple), outside the DDI. */
+static void Ps5HpOnRequest(BC250_DEVICE* Device)
+{
+    LONG id = InterlockedExchange(&g_Ps5Hp.RequestId, 0) - 1;
+    const struct ps5_timing* t;
+    LARGE_INTEGER pause;
+    NTSTATUS status, off, on;
+    if (id < 0 || id >= PS5_MODE_COUNT) return;
+    t = &ps5_display_modes[id].t;
+    GuardLog("ps5 realmode: request %ld %ux%u %lu kHz", id, t->h, t->v, t->clock_khz);
+    status = Ps5HpModeChange(Device, (ULONG)id, t->clock_khz, t->h, t->v);
+    GuardPs5Note(L"RealModeStatus", (ULONG)status);
+    if (NT_SUCCESS(status)) {
+        /* Windows committed this mode itself (Settings): no replug - after one dxgkrnl restores the mode saved for the monitor
+         * and undoes the change. Its primary is already at the new size; the black pattern goes at once, not at the next flip. */
+        Ps5HpAfterFlip(Device);
+        GuardLog("ps5 realmode: mode change 0x%08X, picture on", (ULONG)status);
+        return;
+    }
+    /* failed: the old mode runs again (K6) - the replug makes Windows take the running tuple back */
+    off = ConnectorPs5Indicate(Device, FALSE);
+    pause.QuadPart = -5000000ll;
+    if (KeWaitForSingleObject(&g_Ps5Hp.Stop, Executive, KernelMode, FALSE, &pause) != STATUS_TIMEOUT) return;
+    on = ConnectorPs5Indicate(Device, TRUE);
+    GuardLog("ps5 realmode: mode change 0x%08X, replug %08lX/%08lX", (ULONG)status, (ULONG)off, (ULONG)on);
+}
