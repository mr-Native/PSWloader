+
+// 0.7.216.1230: the running mode, then the replay modes the EDID offers that Ps5HpModeChange would accept (same pitch rule,
+// surface below the firmware tail). The EDID is the one served to Windows (boot variable or the last hotplug).
+ULONG Ps5RealModes(_In_ const BC250_DEVICE* Device, _Out_writes_(PS5_REAL_MODE_MAX) PS5_REAL_MODE* Out)
+{
+    static struct ps5_edid_info info;               /* 1.4 KB: not on the stack; callers are serialised by dxgkrnl */
+    static volatile LONG lastKey = -1;
+    ULONG n = 0, cur = HpCurrentMode(Device), id;
+    LONG key;
+    BOOLEAN changed;
+    if (!Device->InheritedSignalValid) return 0;
+    Out[0].Id = cur; Out[0].Width = Device->Post.Width; Out[0].Height = Device->Post.Height; Out[0].Pitch = Device->Post.Pitch;
+    Out[0].Signal = Device->InheritedSignal; n = 1;
+    key = (LONG)((Ps5HpRealModesOn() ? 1 : 0) | (cur < PS5_MODE_COUNT ? 2 : 0) | (Device->Modeset.DescriptorServed ? 4 : 0) |
+                 (Device->Modeset.EdidLength >= 128 ? 8 : 0) | (cur & 0xff) << 8);
+    changed = InterlockedExchange(&lastKey, key) != key;
+    if (changed) GuardPs5Note(L"RealModeKey", (ULONG)key);
+    if (changed)
+        GuardLog("ps5 realmode: on %u current %lu descriptor %u edid %lu bytes", Ps5HpRealModesOn(), cur,
+                 (UINT)Device->Modeset.DescriptorServed, Device->Modeset.EdidLength);
+    if (!Ps5HpRealModesOn() || cur >= PS5_MODE_COUNT || !Device->Modeset.DescriptorServed || Device->Modeset.EdidLength < 128) return n;
+    if (ps5_edid_parse(Device->Modeset.Edid, Device->Modeset.EdidLength, &info) != 0) { if (changed) GuardLog("ps5 realmode: EDID not parsed"); return n; }
+    for (id = 0; id < PS5_MODE_COUNT && n < PS5_REAL_MODE_MAX; id++) {
+        const struct ps5_dcn201_mode_replay* R = Ps5HpReplay(id);
+        const struct ps5_timing* t = &ps5_display_modes[id].t;
+        ULONG pitch;
+        if (id == cur || R == NULL || ps5_display_offered(&info, (enum ps5_mode_id)id) != 1) continue;
+        pitch = R->pitch_pixels * 4u;
+        if (R->width != t->h || R->height != t->v || pitch != DcnPrimaryPitch(R->width) ||
+            PS5_DCN201_REPLAY_SURFACE + (ULONGLONG)pitch * R->height > 0x46E000000ull) continue;
+        if (changed) GuardLog("ps5 realmode: mode %lu %ux%u offered", id, t->h, t->v);
+        Out[n].Id = id; Out[n].Width = t->h; Out[n].Height = t->v; Out[n].Pitch = pitch;
+        HpSignal(t, &Out[n].Signal);
+        n++;
+    }
+    {
+        static volatile LONG calls;
+        LONG c = InterlockedIncrement(&calls);
+        if (c <= 40 || (c % 200) == 0) GuardLog("ps5 realmode: call %ld -> %lu mode(s)%s%s%s", c, n, n > 1 ? " +" : "",
+                                               n > 1 ? ps5_display_modes[Out[1].Id].name : "", n > 2 ? " ..." : "");
+    }
+    return n;
+}
