+// 0.7.216.1230 (real modes): the timings Windows may pick in Settings - the running mode first, then every mode with a replay
+// that the monitor's EDID offers. Count 1 (only the running mode) when the feature is off or nothing else fits.
+#define PS5_REAL_MODE_MAX 8
+typedef struct { ULONG Id, Width, Height, Pitch; D3DKMDT_VIDEO_SIGNAL_INFO Signal; } PS5_REAL_MODE;
+ULONG Ps5RealModes(_In_ const BC250_DEVICE* Device, _Out_writes_(PS5_REAL_MODE_MAX) PS5_REAL_MODE* Out);
+BOOLEAN Ps5HpRealModesOn(void);                       // wddm.c: waiter thread runs with EnableHotplugModeSet bit 4
+NTSTATUS Ps5HpRequestMode(ULONG ModeId);              // wddm.c: queue a mode change for the waiter thread (any IRQL <= DISPATCH)
 #endif
