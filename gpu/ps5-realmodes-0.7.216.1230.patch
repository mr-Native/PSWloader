+static ULONG Ps5HpSetting(void);
+BOOLEAN Ps5HpRealModesOn(void)
+{
+    /* the setting, not the thread: dxgkrnl enumerates the modes at start, before the waiter thread runs (the request
+     * itself waits for the thread). Read once at PASSIVE, then cached. */
+    static volatile LONG cached = -1;
+    LONG v = InterlockedCompareExchange(&cached, 0, 0);
+    if (v < 0) {
+        if (KeGetCurrentIrql() != PASSIVE_LEVEL) return FALSE;
+        v = (Ps5HpSetting() & (PS5_HP_BIT_WAITER | PS5_HP_BIT_MODESET)) == (PS5_HP_BIT_WAITER | PS5_HP_BIT_MODESET) ? 1 : 0;
+        InterlockedExchange(&cached, v);
+    }
+    return v != 0;
+}
+NTSTATUS Ps5HpRequestMode(ULONG ModeId)
+{
+    if (!Ps5HpRealModesOn() || ModeId >= PS5_MODE_COUNT || InterlockedCompareExchange(&g_Ps5Hp.Running, 0, 0) == 0)
+        return STATUS_NOT_SUPPORTED;
+    InterlockedExchange(&g_Ps5Hp.RequestId, (LONG)ModeId + 1);
+    KeSetEvent(&g_Ps5Hp.ModeRequest, IO_NO_INCREMENT, FALSE);
+    return STATUS_SUCCESS;
+}
