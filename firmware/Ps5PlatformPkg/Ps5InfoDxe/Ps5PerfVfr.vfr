// Ps5InfoDxe v1.2 (r5.28.15): Power Presets moved to Windows PSWloader Dashboard (Power & Fan tab);
// UEFI tab keeps only the info note and CPU P-states under "Advanced".
// SPDX-License-Identifier: BSD-2-Clause-Patent
#include <Uefi/UefiMultiPhase.h>
#include "../Include/Ps5PowerPreset.h"
#define PS5_FRONT_PAGE_CLASS {0xe58809f8,0xfbc1,0x48e2,{0x88,0x3a,0xa3,0x0f,0xdc,0x4b,0x44,0x1e}}   // gEfiIfrFrontPageGuid
#define PS5_PERF_FORMSET_GUID {0x9c1e5f2a,0x1360,0x4e1b,{0xb0,0x5e,0x13,0x60,0x0e,0xf1,0x00,0x0a}}
formset
  guid = PS5_PERF_FORMSET_GUID, title = STRING_TOKEN(STR_PERF_TITLE), help = STRING_TOKEN(STR_PERF_HELP), classguid = PS5_FRONT_PAGE_CLASS,
  efivarstore PS5_PSTATES, attribute = 0x00000006, name = Ps5PStates, guid = PS5_POWER_PRESET_GUID;
  form formid = 1, title = STRING_TOKEN(STR_PERF_TITLE);
    subtitle text = STRING_TOKEN(STR_FAN_SUB);
    text help = STRING_TOKEN(STR_FAN_HELP), text = STRING_TOKEN(STR_FAN_L), text = STRING_TOKEN(STR_FAN_V);
    subtitle text = STRING_TOKEN(STR_NULL);
    goto 2, prompt = STRING_TOKEN(STR_ADV_GOTO), help = STRING_TOKEN(STR_ADV_GOTO_HELP);
  endform;
  form formid = 2, title = STRING_TOKEN(STR_PERF_ADV_TITLE);
    subtitle text = STRING_TOKEN(STR_CPU_SUB);
    oneof varid = Ps5PStates.Value, questionid = PS5_PSTATE_KEY,
      prompt = STRING_TOKEN(STR_PST), help = STRING_TOKEN(STR_PST_HELP), flags = INTERACTIVE,
      option text = STRING_TOKEN(STR_FAST_OFF), value = 0, flags = DEFAULT;
      option text = STRING_TOKEN(STR_FAST_ON), value = 1, flags = 0;
    endoneof;
  endform;
endformset;
