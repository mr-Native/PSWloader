+/* v1.0.5: version of a PSWloader firmware image = the patch number in its UTF-16 string "PSWloader v1.0.N"
+ * ("PSWloader v1.0" alone = 0); -1 if the image carries no such string (build from before v1.0). */
+static int psw_fw_version(const unsigned char *b, size_t n) {
+  static const char tag[] = "PSWloader v1.0";
+  size_t tl = sizeof(tag) - 1;
+  for (size_t i = 0; i + 2 * tl + 4 <= n; i++) {
+    size_t k = 0;
+    while (k < tl && b[i + 2 * k] == (unsigned char)tag[k] && b[i + 2 * k + 1] == 0) k++;
+    if (k != tl) continue;
+    size_t j = i + 2 * tl;
+    if (b[j] != '.' || b[j + 1] != 0) return 0;
+    int v = 0, d = 0;
+    for (j += 2; j + 1 < n && b[j] >= '0' && b[j] <= '9' && b[j + 1] == 0 && d < 4; j += 2, d++) v = v * 10 + (b[j] - '0');
+    return d ? v : 0;
+  }
+  return -1;
+}
+
+/* v1.0.5 (2026-11-23): firmware revision from the ASCII marker "PSWFWREV:rA.B.C" as A*1000000+B*1000+C; -1 without it.
+ * Two v1.0.5 builds (beta r5.25.14, release r5.25.18) share "PSWloader v1.0.5", so the version alone cannot order them. */
+static long psw_fw_rev(const unsigned char *b, size_t n) {
+  static const char tag[] = "PSWFWREV:r";
+  size_t tl = sizeof(tag) - 1;
+  for (size_t i = 0; i + tl + 5 <= n; i++) {
+    if (memcmp(b + i, tag, tl) != 0 || b[i + tl] < '0' || b[i + tl] > '9') continue;
+    long part[3] = {0, 0, 0}; int k = 0; size_t j = i + tl;
+    while (j < n && k < 3) {
+      int d = 0;
+      while (j < n && b[j] >= '0' && b[j] <= '9' && d < 4) { part[k] = part[k] * 10 + (b[j] - '0'); j++; d++; }
+      if (!d) return -1;
+      k++;
+      if (k < 3) { if (j < n && b[j] == '.') j++; else return -1; }
+    }
+    return k == 3 ? part[0] * 1000000 + part[1] * 1000 + part[2] : -1;
+  }
+  return -1;
+}
