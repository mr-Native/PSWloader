; ps5m2flt.inf v1.0 - extension INF for Windows Setup/WinPE and the installed system.
; Upper filter on the disk device of the internal SanDisk only (device filter, below the class filter partmgr - the
; same position as "ps5m2flt first" in the class list today): Windows sees only the nested GPT from LBA 65536, the
; GameOS areas (LBA 0-65535, last 34224 sectors) stay invisible. Other disks (USB stick) get no filter.
[Version]
Signature   = "$WINDOWS NT$"
Class       = Extension
ClassGuid   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
ExtensionId = {bd5f4b80-d659-497d-b2d6-9360b3c758f8}
Provider    = %Provider%
DriverVer   = 11/21/2026,1.2.5.0
CatalogFile = ps5m2flt.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %Disk%

[SourceDisksFiles]
ps5m2flt.sys = 1

[Manufacturer]
%Provider% = Models, NTamd64.10.0...19041

[Models.NTamd64.10.0...19041]
%Desc% = Install, SCSI\DiskNVMe____

[Install.NT]
CopyFiles = Files

[Files]
ps5m2flt.sys

[Install.NT.Filters]
AddFilter = ps5m2flt,, FilterUpper

[FilterUpper]
FilterPosition = Upper

[Install.NT.Services]
AddService = ps5m2flt,, Service

[Service]
DisplayName    = %Desc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1
LoadOrderGroup = "System Bus Extender"
ServiceBinary  = %13%\ps5m2flt.sys

[Strings]
Provider = "PSWloader"
Disk     = "PS5 storage drivers"
Desc     = "PS5 M.2 Nested GPT Overlay Filter"
