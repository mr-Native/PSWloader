; ps5wifi.inf v1.0.3 - PS5 Wi-Fi 6 (NXP/Marvell IW620, PCI 1B4B:2B56), NDIS 6.20 Native 802.11 miniport
; Signed with the PSWloader Driver Signing certificate. GPL-2.0-only (see ps5wifi.c).
[Version]
Signature   = "$WINDOWS NT$"
Class       = Net
ClassGUID   = {4d36e972-e325-11ce-bfc1-08002be10318}
Provider    = %Mfg%
CatalogFile = ps5wifi.cat
DriverVer   = 11/22/2026,1.0.3.1
PnpLockdown = 1

[Manufacturer]
%Mfg% = PS5, NTamd64

[PS5.NTamd64]
%DevDesc% = PS5WIFI.ndi, PCI\VEN_1B4B&DEV_2B56

[PS5WIFI.ndi.NTamd64]
Characteristics     = 0x84
BusType             = 5
*IfType             = 71
*MediaType          = 16
*PhysicalMediaType  = 9
*IfConnectorPresent = 1
*ConnectionType     = 1
*DirectionType      = 0
*AccessType         = 2
*HardwareLoopback   = 0
AddReg              = PS5WIFI.Reg
CopyFiles           = PS5WIFI.CopyFiles

[PS5WIFI.ndi.NTamd64.HW]
AddReg = PS5WIFI.HW.Reg

[PS5WIFI.HW.Reg]
HKR, "Interrupt Management", 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", 0x00000010
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MSISupported, 0x00010001, 1
HKR, "Interrupt Management\MessageSignaledInterruptProperties", MessageNumberLimit, 0x00010001, 1

[PS5WIFI.ndi.NTamd64.Services]
AddService = ps5wifi, 2, PS5WIFI.Service

[PS5WIFI.Reg]
HKR, Ndi,            Service,    0, "ps5wifi"
HKR, Ndi\Interfaces, UpperRange, 0, "ndis5"
HKR, Ndi\Interfaces, LowerRange, 0, "wlan,ethernet"

[PS5WIFI.Service]
DisplayName    = %DevDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %13%\ps5wifi.sys
LoadOrderGroup = NDIS

[PS5WIFI.CopyFiles]
ps5wifi.sys

[SourceDisksNames]
1 = %DiskDesc%

[SourceDisksFiles]
ps5wifi.sys = 1

[DestinationDirs]
PS5WIFI.CopyFiles = 13

[Strings]
Mfg      = "PSWloader"
DevDesc  = "PS5 Wi-Fi 6 Adapter (ps5wifi)"
DiskDesc = "ps5wifi driver"
